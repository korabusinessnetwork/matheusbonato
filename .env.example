# Copie para .env e preencha. O .env NÃO é versionado.
# Só variáveis com prefixo VITE_ chegam ao navegador — jamais coloque segredo aqui:
# tudo que tem VITE_ fica público no bundle.

# WhatsApp que recebe os pedidos. Formato: DDI + DDD + número, só dígitos.
# Ex.: 5544999998888  (55 = Brasil, 44 = DDD, resto = número)
VITE_WHATSAPP_NUMERO=5544999998888
